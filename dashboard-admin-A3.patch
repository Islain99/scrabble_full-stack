+export const getHint = async (gameId, playerId) =>
+  (await api.post(`/game/hint/${gameId}`, null, {
+    baseURL: api.defaults.baseURL.replace(/\/api\/v2\/?$/, ''),
+    params: { player_id: playerId },
+    timeout: 20000,
+  })).data;
