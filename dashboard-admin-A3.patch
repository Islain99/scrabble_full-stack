+class EconomyAdminOut(BaseModel):
+    rules: dict
+    custom: bool
+    updated_at: Optional[datetime] = None
+    updated_by_name: Optional[str] = None
+    stats: dict
+    kept_unlocks: int = 0          # palettes devenues premium, gardées par ceux qui les utilisaient
