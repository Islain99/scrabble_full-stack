+async def _tier_or_404(db: AsyncSession, tier_id: int) -> SubscriptionTier:
+    tier = await db.get(SubscriptionTier, tier_id)
+    if tier is None:
+        raise HTTPException(status_code=404, detail="Niveau introuvable.")
+    return tier
