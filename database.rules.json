{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends').child($uid).child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'last_active']) && newData.child('state').isString() && newData.child('state').val().matches(/^(online|playing|offline)$/) && newData.child('last_active').isNumber()"
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "lobby": {
      ".read": "auth != null"
    },

    "games": {
      "$roomId": {
        "for_host": {
          ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('players/host').val()"
        },
        "for_guest": {
          ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('players/guest').val()"
        }
      }
    }
  }
}
