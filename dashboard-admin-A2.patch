+/* ── Lot A2 : paramètres des joueurs ───────────────────────────── */
+.adm-intro { display: flex; flex-direction: column; gap: 10px; }
+.adm-legend { margin: 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 3px; font-family: 'Libre Baskerville', Georgia, serif; font-size: 0.84rem; color: var(--text-primary); }
+.adm-set-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
+.adm-table-wrap--flat { border-width: 1.5px; }
+.adm-set-table th[scope="row"] { position: static; background: none; color: var(--text-primary); text-transform: none; letter-spacing: 0; font-family: 'Playfair Display', Georgia, serif; font-size: 0.9rem; font-weight: 700; white-space: normal; padding: 10px 12px; border-top: 1px solid var(--border-muted); min-width: 150px; }
+.adm-set-table tbody tr:first-child th[scope="row"] { border-top: none; }
+.adm-set-table tr[data-mode="locked"] th[scope="row"]::after { content: ' 🔒'; font-size: 0.75rem; }
+.adm-set-table tr[data-mode="hidden"] th[scope="row"] { color: var(--text-muted); text-decoration: line-through; text-decoration-thickness: 1px; }
+.adm-seg { display: inline-flex; border: 1.5px solid var(--border-primary); border-radius: 2px; overflow: hidden; }
+.adm-seg-btn {
+  padding: 5px 9px; border: none; background: transparent; cursor: pointer; white-space: nowrap;
+  font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted);
+}
+.adm-seg-btn + .adm-seg-btn { border-left: 1.5px solid var(--border-primary); }
+.adm-seg-btn[aria-checked="true"] { background: var(--bg-invert); color: var(--text-invert); }
+.adm-seg-btn[aria-checked="true"][data-mode="locked"] { background: var(--tobacco); color: var(--text-invert); }
+.adm-seg-btn[aria-checked="true"][data-mode="hidden"] { background: var(--brick); color: var(--text-invert); }
+.adm-seg-btn:disabled { opacity: 0.35; cursor: not-allowed; }
+.adm-seg-btn:focus-visible { outline: 2px solid var(--gold); outline-offset: -2px; }
+.adm-input--sm { padding: 5px 8px; font-size: 0.82rem; max-width: 220px; }
