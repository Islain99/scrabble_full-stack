+.adm-opt {
+  display: inline-flex; align-items: center; gap: 4px; padding: 3px 7px; cursor: pointer;
+  border: 1px solid var(--border-muted); border-radius: 2px;
+  font-family: 'DM Mono', monospace; font-size: 0.64rem; color: var(--text-muted);
+}
+.adm-opt[data-on] { border-color: var(--border-primary); color: var(--text-primary); }
