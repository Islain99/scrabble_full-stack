# Modèle de configuration du backend.
# Copier en `.env` (jamais commité) : cp .env.example .env
# En production, ces valeurs sont définies dans Railway → Variables.

# development | production   (production : docs /docs désactivées, TrustedHost actif)
APP_ENV=development

# PostgreSQL. Vide = l'API démarre sans DB (routes /api/v2 en 503).
# postgres:// et postgresql:// sont convertis automatiquement en postgresql+asyncpg://
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scrabble

# Origines CORS autorisées, séparées par des virgules (sinon valeurs par défaut de config.py)
# ALLOWED_ORIGINS=http://localhost:5173,https://scrabble-full-stack.vercel.app

# ── Firebase Admin ────────────────────────────────────────────────
# Option 1 (Railway) : le JSON complet du compte de service, sur une ligne
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option 2 (local) : chemin vers le fichier JSON (ne JAMAIS le committer)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# URL de la Realtime Database (synchronisation multijoueur)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
